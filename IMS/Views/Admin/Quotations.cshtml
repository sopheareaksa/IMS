@model IEnumerable<IMS.Models.Quotation>
@{
    ViewData["Title"] = "Platform Quotations Master Record";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var selectedScope = ViewBag.SelectedScope as string ?? "All";
    int pendingCount = Model.Count(q => q.status == "Pending");
    int acceptedCount = Model.Count(q => q.status == "Accepted");
}

<div class="page-header">
    <div>
        <div class="page-header-title">Quotations Master Record</div>
        <div class="page-header-sub">Review, calibrate, and approve quote applications across platform products and partner carrier listings.</div>
    </div>
    <div class="page-header-actions">
        <div class="btn-group" role="group">
            <a asp-action="Quotations" asp-route-status="All" asp-route-scope="@selectedScope" class="btn btn-sm @(selectedStatus == "All" ? "btn-primary" : "btn-outline")">All</a>
            <a asp-action="Quotations" asp-route-status="Pending" asp-route-scope="@selectedScope" class="btn btn-sm @(selectedStatus == "Pending" ? "btn-primary" : "btn-outline")">Pending (@pendingCount)</a>
            <a asp-action="Quotations" asp-route-status="Accepted" asp-route-scope="@selectedScope" class="btn btn-sm @(selectedStatus == "Accepted" ? "btn-primary" : "btn-outline")">Accepted (@acceptedCount)</a>
            <a asp-action="Quotations" asp-route-status="Rejected" asp-route-scope="@selectedScope" class="btn btn-sm @(selectedStatus == "Rejected" ? "btn-primary" : "btn-outline")">Rejected</a>
        </div>
    </div>
</div>

<!-- Scope Filter Bar -->
<div class="filter-bar">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-funnel text-muted"></i>
        <span class="small fw-bold text-secondary">Carrier Scope:</span>
    </div>
    <div class="btn-group" role="group">
        <a asp-action="Quotations" asp-route-status="@selectedStatus" asp-route-scope="All" class="btn btn-sm @(selectedScope == "All" ? "btn-primary" : "btn-outline")">All Plans</a>
        <a asp-action="Quotations" asp-route-status="@selectedStatus" asp-route-scope="AdminPlans" class="btn btn-sm @(selectedScope == "AdminPlans" ? "btn-primary" : "btn-outline")">Host Platform Only</a>
        <a asp-action="Quotations" asp-route-status="@selectedStatus" asp-route-scope="PartnerPlans" class="btn btn-sm @(selectedScope == "PartnerPlans" ? "btn-primary" : "btn-outline")">Partner Carriers</a>
    </div>
</div>

<!-- Table Panel -->
<div class="panel">
    <div class="panel-header">
        <div class="panel-title"><i class="bi bi-chat-left-quote me-2 text-primary"></i>Underwriting Quotes Master Ledger</div>
        <span class="badge badge-gray">@Model.Count() records</span>
    </div>

    <!-- Actions Toolbar Outside Table -->
    <div class="table-actions-toolbar" id="quote-toolbar">
        <div class="toolbar-label">
            <span class="badge bg-secondary-subtle text-secondary border py-1.5 px-2" id="quote-selected-badge">
                <i class="bi bi-info-circle me-1"></i>No quotation selected
            </span>
            <span class="text-muted small" id="quote-selected-name">Select a quotation from the table to perform underwriting</span>
        </div>
        <div class="toolbar-btns">
            <form id="quote-form-accept" asp-action="AcceptQuote" method="post" class="d-inline m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="quote-accept-id" />
                <button type="submit" id="quote-btn-accept" class="btn btn-sm btn-success" disabled>
                    <i class="bi bi-check-lg me-1"></i>Accept Quote
                </button>
            </form>
            <form id="quote-form-reject" asp-action="RejectQuote" method="post" class="d-inline m-0" onsubmit="return confirm('Decline this quotation request?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="quote-reject-id" />
                <button type="submit" id="quote-btn-reject" class="btn btn-sm btn-ghost-danger" disabled>
                    <i class="bi bi-x-lg me-1"></i>Decline
                </button>
            </form>
            <a id="quote-btn-issue" href="#" class="btn btn-sm btn-primary disabled" tabindex="-1" aria-disabled="true">
                <i class="bi bi-qr-code-scan me-1"></i>Issue Policy & Pay
            </a>
            <a id="quote-btn-viewpol" asp-action="Policies" class="btn btn-sm btn-outline text-success d-none">
                <i class="bi bi-file-earmark-check me-1"></i><span id="quote-viewpol-text">View Active Policy</span>
            </a>
            <span id="quote-partner-badge" class="badge badge-gray d-none">
                <i class="bi bi-lock-fill text-muted me-1"></i>Carrier Managed (Underwriting by partner)
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle selectable-table mb-0" id="quotations-table">
            <thead>
                <tr>
                    <th style="width: 44px;" class="text-center">
                        <i class="bi bi-check2-circle text-muted"></i>
                    </th>
                    <th>Quote Ref</th>
                    <th>Customer Applicant</th>
                    <th>Plan & Carrier</th>
                    <th>Est. Premium</th>
                    <th>Request Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var q in Model)
                    {
                        var isHostPlan = q.InsuranceProduct?.Company?.isHostCompany == true;
                        var hasPolicy = q.InsurancePolicy != null;
                        var policyNumber = q.InsurancePolicy?.policyNumber ?? "";

                        <tr class="selectable-row" data-id="@q.quoteId" data-customer="@(q.Customer?.fullName ?? "Applicant")"
                            data-plan="@(q.InsuranceProduct?.name ?? "Plan")" data-status="@q.status"
                            data-ishost="@(isHostPlan ? "true" : "false")" data-haspolicy="@(hasPolicy ? "true" : "false")"
                            data-policynumber="@policyNumber">
                            <td class="text-center" onclick="event.stopPropagation();">
                                <input type="radio" name="selectedQuote" class="form-check-input quote-radio"
                                       data-id="@q.quoteId" data-customer="@(q.Customer?.fullName ?? "Applicant")"
                                       data-plan="@(q.InsuranceProduct?.name ?? "Plan")" data-status="@q.status"
                                       data-ishost="@(isHostPlan ? "true" : "false")" data-haspolicy="@(hasPolicy ? "true" : "false")"
                                       data-policynumber="@policyNumber" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark font-monospace">#@q.quoteId</div>
                                @if (isHostPlan)
                                {
                                    <span class="badge badge-primary mt-1"><i class="bi bi-shield-check"></i> Host Plan</span>
                                }
                            </td>
                            <td>
                                <div class="cell-primary fw-bold text-dark">@(q.Customer?.fullName ?? "Applicant")</div>
                                <div class="cell-sub"><i class="bi bi-telephone me-1"></i>@(q.Customer?.phone ?? "N/A")</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(q.InsuranceProduct?.name ?? "Plan")</div>
                                <div class="cell-sub">Carrier: <strong>@(q.InsuranceProduct?.Company?.name ?? "Host Platform")</strong></div>
                                @if (q.HandlingAgent != null)
                                {
                                    <div class="cell-sub text-primary"><i class="bi bi-person-badge me-1"></i>@q.HandlingAgent.fullName</div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-success fs-6">$@q.estimatedPremium.ToString("N2")</div>
                                @if (!string.IsNullOrWhiteSpace(q.message))
                                {
                                    <div class="cell-sub text-truncate" style="max-width: 220px;" title="@q.message">
                                        <i class="bi bi-chat-dots me-1"></i>@q.message
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="text-dark small">@q.requestDate.ToString("MMM dd, yyyy")</div>
                                <div class="cell-sub">@q.requestDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @if (q.status == "Accepted")
                                {
                                    <span class="badge badge-success"><i class="bi bi-check-circle me-1"></i>Accepted</span>
                                }
                                else if (q.status == "Pending")
                                {
                                    <span class="badge badge-warning"><i class="bi bi-clock-history me-1"></i>Pending Review</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="bi bi-x-circle me-1"></i>@q.status</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <div class="empty-state-icon"><i class="bi bi-chat-left-dots"></i></div>
                                <div class="empty-state-title">No quotations found</div>
                                <div class="empty-state-desc">There are currently no quotation submissions under this status or scope filter.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const table = document.getElementById('quotations-table');
        if (!table) return;

        const btnAccept = document.getElementById('quote-btn-accept');
        const acceptId = document.getElementById('quote-accept-id');
        const btnReject = document.getElementById('quote-btn-reject');
        const rejectId = document.getElementById('quote-reject-id');
        const btnIssue = document.getElementById('quote-btn-issue');
        const btnViewPol = document.getElementById('quote-btn-viewpol');
        const viewPolText = document.getElementById('quote-viewpol-text');
        const partnerBadge = document.getElementById('quote-partner-badge');
        const badge = document.getElementById('quote-selected-badge');
        const nameLabel = document.getElementById('quote-selected-name');

        function selectQuote(row) {
            table.querySelectorAll('tbody tr').forEach(r => r.classList.remove('row-selected'));
            row.classList.add('row-selected');
            const radio = row.querySelector('.quote-radio');
            if (radio) radio.checked = true;

            const id = row.getAttribute('data-id');
            const customer = row.getAttribute('data-customer');
            const plan = row.getAttribute('data-plan');
            const status = row.getAttribute('data-status');
            const isHost = row.getAttribute('data-ishost') === 'true';
            const hasPolicy = row.getAttribute('data-haspolicy') === 'true';
            const policyNumber = row.getAttribute('data-policynumber');

            badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle py-1.5 px-2';
            badge.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Selected';
            nameLabel.innerHTML = '<strong>Quote #' + id + '</strong> &bull; ' + customer + ' - ' + plan + ' (' + status + ')';

            // Reset buttons
            btnAccept.disabled = true;
            btnReject.disabled = true;
            btnIssue.classList.add('disabled');
            btnIssue.setAttribute('tabindex', '-1');
            btnIssue.setAttribute('aria-disabled', 'true');
            btnIssue.href = '#';
            btnViewPol.classList.add('d-none');
            partnerBadge.classList.add('d-none');

            if (status === 'Pending') {
                if (isHost) {
                    btnAccept.disabled = false;
                    acceptId.value = id;
                    btnReject.disabled = false;
                    rejectId.value = id;
                } else {
                    partnerBadge.classList.remove('d-none');
                }
            } else if (status === 'Accepted') {
                if (hasPolicy) {
                    btnViewPol.classList.remove('d-none');
                    viewPolText.textContent = 'View Policy: ' + policyNumber;
                } else if (isHost) {
                    btnIssue.classList.remove('disabled');
                    btnIssue.removeAttribute('tabindex');
                    btnIssue.removeAttribute('aria-disabled');
                    btnIssue.href = '@Url.Action("IssuePolicy", "Payment")?quoteId=' + id;
                }
            }
        }

        table.querySelectorAll('tbody tr.selectable-row').forEach(row => {
            row.addEventListener('click', function () {
                selectQuote(this);
            });
        });

        table.querySelectorAll('.quote-radio').forEach(radio => {
            radio.addEventListener('change', function () {
                const row = this.closest('tr');
                if (row) selectQuote(row);
            });
        });
    });
</script>
}


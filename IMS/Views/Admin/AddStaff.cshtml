@model IMS.ViewModels.AddStaffViewModel
@{
    ViewData["Title"] = "Add Staff Member";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 15px;">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Add New Staff Member</h6>
                        <small class="text-muted">Create an account assigned to an insurance carrier & supervisor</small>
                    </div>
                </div>
                <a asp-action="Staff" class="btn btn-sm btn-outline">
                    <i class="bi bi-arrow-left"></i> Directory
                </a>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="AddStaff" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert-banner danger mb-4" role="alert"></div>

                    <!-- Step 1: Identity & Agency -->
                    <div class="mb-4 pb-3" style="border-bottom: 1px solid #f1f5f9;">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div style="width: 22px; height: 22px; border-radius: 6px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700;">1</div>
                            <span style="font-size: 13px; font-weight: 700; color: #1e293b; text-transform: uppercase; letter-spacing: .04em;">Staff Identity & Assignment</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">Full Legal Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control" placeholder="e.g. Alice Johnson" required />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control" placeholder="+855 12 345 678" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CompanyId" class="form-label">Assigned Carrier / Agency <span class="text-danger">*</span></label>
                                <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.Companies" required></select>
                                <span asp-validation-for="CompanyId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AgentId" class="form-label">Supervising Lead Agent <span class="text-danger">*</span></label>
                                <select asp-for="AgentId" class="form-select" asp-items="ViewBag.Agents" required></select>
                                <span asp-validation-for="AgentId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Login Credentials -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div style="width: 22px; height: 22px; border-radius: 6px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700;">2</div>
                            <span style="font-size: 13px; font-weight: 700; color: #1e293b; text-transform: uppercase; letter-spacing: .04em;">Login Credentials</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label">Username <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-at"></i></span>
                                    <input asp-for="Username" class="form-control font-monospace" placeholder="alice_staff" required />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" type="email" placeholder="alice@company.com" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Password" class="form-label">Temporary Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control" type="password" placeholder="At least 6 characters" required />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Alerts Switch Card -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" asp-for="ReceiveAlerts" id="alertSwitch" />
                            <label class="form-check-label fw-bold text-dark ms-2" for="alertSwitch">
                                Enable Automatic Quotation & Claim Alerts
                            </label>
                        </div>
                        <small class="text-muted ps-4 d-block">Staff member will receive system notifications whenever customer quotes or claims are filed for this carrier.</small>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                        <a asp-action="Staff" class="btn btn-outline btn-md">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary btn-md">
                            <i class="bi bi-check-circle-fill"></i> Create Staff Member
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

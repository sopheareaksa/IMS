@model IEnumerable<IMS.Models.Staff>
@{
    ViewData["Title"] = "Platform Staff Management";
    var companies = ViewBag.Companies as List<IMS.Models.Company> ?? new();
    int? selectedComp = ViewBag.SelectedCompanyId as int?;
}

<div class="page-header">
    <div>
        <div class="page-header-title">Staff Members Directory</div>
        <div class="page-header-sub">Supervise active personnel across host platform and partner carrier agencies.</div>
    </div>
    <div class="page-header-actions">
        <a asp-action="AddStaff" class="btn btn-primary btn-md">
            <i class="bi bi-person-plus-fill"></i> Add New Staff Member
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-funnel text-muted"></i>
        <span class="small fw-bold text-secondary">Filter by Carrier Agency:</span>
    </div>
    <form method="get" class="d-flex align-items-center gap-2 m-0 flex-grow-1" style="max-width: 380px;">
        <select name="companyId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Companies & Host (@Model.Count() Staff)</option>
            @foreach (var comp in companies)
            {
                <option value="@comp.companyId" selected="@(selectedComp == comp.companyId)">@comp.name</option>
            }
        </select>
        @if (selectedComp.HasValue)
        {
            <a asp-action="Staff" class="btn btn-sm btn-outline text-muted" title="Clear filter">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </form>
</div>

<!-- Staff Table Panel -->
<div class="panel">
    <div class="panel-header">
        <div class="panel-title"><i class="bi bi-people me-2 text-primary"></i>Assigned Operating Staff</div>
        <span class="badge badge-gray">@Model.Count() records</span>
    </div>

    <!-- Actions Toolbar Outside Table -->
    <div class="table-actions-toolbar" id="staff-toolbar">
        <div class="toolbar-label">
            <span class="badge bg-secondary-subtle text-secondary border py-1.5 px-2" id="staff-selected-badge">
                <i class="bi bi-info-circle me-1"></i>No staff selected
            </span>
            <span class="text-muted small" id="staff-selected-name">Select a staff member from the table to perform actions</span>
        </div>
        <div class="toolbar-btns">
            <a id="staff-btn-edit" href="#" class="btn btn-sm btn-outline disabled" tabindex="-1" aria-disabled="true">
                <i class="bi bi-pencil-square text-primary me-1"></i>Edit Staff
            </a>
            <form id="staff-form-alerts" asp-action="ToggleStaffAlerts" method="post" class="d-inline m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="staff-alerts-id" />
                <button type="submit" id="staff-btn-alerts" class="btn btn-sm btn-outline" disabled>
                    <i class="bi bi-bell me-1" id="staff-alerts-icon"></i>
                    <span id="staff-alerts-text">Toggle Alerts</span>
                </button>
            </form>
            <form id="staff-form-delete" asp-action="DeleteStaff" method="post" class="d-inline m-0" onsubmit="return confirm('Are you sure you want to remove this staff member?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="staff-delete-id" />
                <button type="submit" id="staff-btn-delete" class="btn btn-sm btn-ghost-danger" disabled>
                    <i class="bi bi-trash me-1"></i>Remove
                </button>
            </form>
            <span id="staff-partner-badge" class="badge badge-gray d-none">
                <i class="bi bi-lock-fill text-muted me-1"></i>Partner Managed (Read-Only)
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle selectable-table mb-0" id="staff-table">
            <thead>
                <tr>
                    <th style="width: 44px;" class="text-center">
                        <i class="bi bi-check2-circle text-muted"></i>
                    </th>
                    <th>Staff Member</th>
                    <th>Account & Credentials</th>
                    <th>Assigned Company</th>
                    <th>Supervising Agent</th>
                    <th>Quotation & Claim Alerts</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        var isHost = s.Company?.isHostCompany == true;
                        <tr class="selectable-row" data-id="@s.staffId" data-name="@s.fullName" data-alerts="@(s.receiveAlerts ? "true" : "false")" data-ishost="@(isHost ? "true" : "false")">
                            <td class="text-center" onclick="event.stopPropagation();">
                                <input type="radio" name="selectedStaff" class="form-check-input staff-radio"
                                       data-id="@s.staffId" data-name="@s.fullName" data-alerts="@(s.receiveAlerts ? "true" : "false")" data-ishost="@(isHost ? "true" : "false")" />
                            </td>
                            <td>
                                <div class="cell-primary d-flex align-items-center gap-2">
                                    <div style="width: 32px; height: 32px; border-radius: 8px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700;">
                                        @(s.fullName.Length > 0 ? s.fullName.Substring(0,1).ToUpper() : "S")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@s.fullName</div>
                                        <div class="cell-sub"><i class="bi bi-telephone me-1"></i>@(s.phone ?? "N/A")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div><code>@(s.UserAccount?.username ?? "N/A")</code></div>
                                <div class="cell-sub">@(s.UserAccount?.email ?? "N/A")</div>
                            </td>
                            <td>
                                @if (isHost)
                                {
                                    <span class="badge badge-primary"><i class="bi bi-shield-check me-1"></i>Host Platform</span>
                                }
                                else
                                {
                                    <span class="badge badge-gray"><i class="bi bi-buildings me-1"></i>@(s.Company?.name ?? "Partner")</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(s.SupervisingAgent?.fullName ?? "Unassigned")</div>
                                <div class="cell-sub">@(s.SupervisingAgent?.branch ?? "HQ")</div>
                            </td>
                            <td>
                                <span class="badge @(s.receiveAlerts ? "badge-success" : "badge-gray")">
                                    <i class="bi @(s.receiveAlerts ? "bi-bell-fill" : "bi-bell-slash") me-1"></i>
                                    @(s.receiveAlerts ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(s.status == "Active" ? "badge-success" : "badge-danger")">
                                    @s.status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <div class="empty-state-icon"><i class="bi bi-people"></i></div>
                                <div class="empty-state-title">No staff members found</div>
                                <div class="empty-state-desc">There are no staff accounts recorded matching your filter selection.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const table = document.getElementById('staff-table');
        if (!table) return;

        const editBtn = document.getElementById('staff-btn-edit');
        const alertsBtn = document.getElementById('staff-btn-alerts');
        const alertsId = document.getElementById('staff-alerts-id');
        const alertsText = document.getElementById('staff-alerts-text');
        const alertsIcon = document.getElementById('staff-alerts-icon');
        const deleteBtn = document.getElementById('staff-btn-delete');
        const deleteId = document.getElementById('staff-delete-id');
        const partnerBadge = document.getElementById('staff-partner-badge');
        const badge = document.getElementById('staff-selected-badge');
        const nameLabel = document.getElementById('staff-selected-name');

        function selectStaff(row) {
            table.querySelectorAll('tbody tr').forEach(r => r.classList.remove('row-selected'));
            row.classList.add('row-selected');
            const radio = row.querySelector('.staff-radio');
            if (radio) radio.checked = true;

            const id = row.getAttribute('data-id');
            const name = row.getAttribute('data-name');
            const alerts = row.getAttribute('data-alerts') === 'true';
            const isHost = row.getAttribute('data-ishost') === 'true';

            badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle py-1.5 px-2';
            badge.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Selected';
            nameLabel.innerHTML = '<strong>' + name + '</strong>';

            if (isHost) {
                partnerBadge.classList.add('d-none');

                editBtn.classList.remove('disabled');
                editBtn.removeAttribute('tabindex');
                editBtn.removeAttribute('aria-disabled');
                editBtn.href = '@Url.Action("EditStaff", "Admin")?id=' + id;

                alertsBtn.disabled = false;
                alertsId.value = id;
                alertsText.textContent = alerts ? 'Disable Alerts' : 'Enable Alerts';
                alertsIcon.className = alerts ? 'bi bi-bell-slash me-1' : 'bi bi-bell-fill me-1';
                alertsBtn.className = alerts ? 'btn btn-sm btn-outline' : 'btn btn-sm btn-success';

                deleteBtn.disabled = false;
                deleteId.value = id;
            } else {
                editBtn.classList.add('disabled');
                editBtn.setAttribute('tabindex', '-1');
                editBtn.setAttribute('aria-disabled', 'true');
                editBtn.href = '#';

                alertsBtn.disabled = true;
                deleteBtn.disabled = true;
                partnerBadge.classList.remove('d-none');
            }
        }

        table.querySelectorAll('tbody tr.selectable-row').forEach(row => {
            row.addEventListener('click', function () {
                selectStaff(this);
            });
        });

        table.querySelectorAll('.staff-radio').forEach(radio => {
            radio.addEventListener('change', function () {
                const row = this.closest('tr');
                if (row) selectStaff(row);
            });
        });
    });
</script>
}


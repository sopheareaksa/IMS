@model IEnumerable<IMS.Models.InsuranceProduct>
@{
    ViewData["Title"] = "Our Insurance Plans";
    var company = ViewBag.Company as IMS.Models.Company;
    int activeCount = Model.Count(p => p.status == "Active");
}

<div class="page-header">
    <div>
        <div class="page-header-title">Agency Insurance Catalog</div>
        <div class="page-header-sub">Manage published products offered by @(company?.name ?? "your carrier agency").</div>
    </div>
    <div class="page-header-actions">
        <a asp-action="CreateProduct" class="btn btn-primary btn-md">
            <i class="bi bi-plus-circle-fill"></i> Add New Plan
        </a>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div class="panel-title"><i class="bi bi-box-seam me-2 text-primary"></i>Published Agency Plans</div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge badge-success"><i class="bi bi-check-circle me-1"></i>@activeCount Active</span>
            <span class="badge badge-gray">@Model.Count() total</span>
        </div>
    </div>

    <!-- Actions Toolbar Outside Table -->
    <div class="table-actions-toolbar" id="agent-prod-toolbar">
        <div class="toolbar-label">
            <span class="badge bg-secondary-subtle text-secondary border py-1.5 px-2" id="agent-prod-badge">
                <i class="bi bi-info-circle me-1"></i>No plan selected
            </span>
            <span class="text-muted small" id="agent-prod-name">Select a plan from the table to perform actions</span>
        </div>
        <div class="toolbar-btns">
            <a id="agent-prod-btn-edit" href="#" class="btn btn-sm btn-outline disabled" tabindex="-1" aria-disabled="true">
                <i class="bi bi-pencil-square text-primary me-1"></i>Edit Plan
            </a>
            <form id="agent-prod-form-toggle" asp-action="ToggleProductStatus" method="post" class="d-inline m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="agent-prod-toggle-id" />
                <button type="submit" id="agent-prod-btn-toggle" class="btn btn-sm btn-outline" disabled>
                    <i class="bi bi-pause-circle me-1" id="agent-prod-toggle-icon"></i>
                    <span id="agent-prod-toggle-text">Toggle Status</span>
                </button>
            </form>
            <form id="agent-prod-form-delete" asp-action="DeleteProduct" method="post" class="d-inline m-0" onsubmit="return confirm('Are you sure you want to delete this plan?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="agent-prod-delete-id" />
                <button type="submit" id="agent-prod-btn-delete" class="btn btn-sm btn-ghost-danger" disabled>
                    <i class="bi bi-trash me-1"></i>Delete Plan
                </button>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle selectable-table mb-0" id="agent-products-table">
            <thead>
                <tr>
                    <th style="width: 44px;" class="text-center">
                        <i class="bi bi-check2-circle text-muted"></i>
                    </th>
                    <th>Plan Name</th>
                    <th>Category</th>
                    <th>Base Annual Premium</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        <tr class="selectable-row" data-id="@p.inProId" data-name="@p.name" data-status="@p.status">
                            <td class="text-center" onclick="event.stopPropagation();">
                                <input type="radio" name="selectedProduct" class="form-check-input agent-prod-radio"
                                       data-id="@p.inProId" data-name="@p.name" data-status="@p.status" />
                            </td>
                            <td>
                                <div class="cell-primary fw-bold text-dark">@p.name</div>
                                <div class="cell-sub text-truncate" style="max-width: 320px;" title="@p.detail">
                                    @(string.IsNullOrWhiteSpace(p.detail) ? "Standard coverage plan" : p.detail)
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-gray"><i class="bi bi-tag-fill me-1 text-muted"></i>@(p.InsuranceType?.name ?? "General")</span>
                            </td>
                            <td>
                                <span class="fw-bold text-success fs-6">$@p.basePremium.ToString("N2")</span>
                                <span class="text-muted small">/ yr</span>
                            </td>
                            <td>
                                <span class="badge @(p.status == "Active" ? "badge-success" : "badge-danger")">
                                    @p.status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <div class="empty-state-icon"><i class="bi bi-box-seam"></i></div>
                                <div class="empty-state-title">No insurance plans yet</div>
                                <div class="empty-state-desc">Publish your agency's first insurance product to receive customer quote requests.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const table = document.getElementById('agent-products-table');
        if (!table) return;

        const editBtn = document.getElementById('agent-prod-btn-edit');
        const toggleBtn = document.getElementById('agent-prod-btn-toggle');
        const toggleId = document.getElementById('agent-prod-toggle-id');
        const toggleText = document.getElementById('agent-prod-toggle-text');
        const toggleIcon = document.getElementById('agent-prod-toggle-icon');
        const deleteBtn = document.getElementById('agent-prod-btn-delete');
        const deleteId = document.getElementById('agent-prod-delete-id');
        const badge = document.getElementById('agent-prod-badge');
        const nameLabel = document.getElementById('agent-prod-name');

        function selectProduct(row) {
            table.querySelectorAll('tbody tr').forEach(r => r.classList.remove('row-selected'));
            row.classList.add('row-selected');
            const radio = row.querySelector('.agent-prod-radio');
            if (radio) radio.checked = true;

            const id = row.getAttribute('data-id');
            const name = row.getAttribute('data-name');
            const status = row.getAttribute('data-status');

            badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle py-1.5 px-2';
            badge.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Selected';
            nameLabel.innerHTML = '<strong>' + name + '</strong> (' + status + ')';

            editBtn.classList.remove('disabled');
            editBtn.removeAttribute('tabindex');
            editBtn.removeAttribute('aria-disabled');
            editBtn.href = '@Url.Action("EditProduct", "Agent")?id=' + id;

            toggleBtn.disabled = false;
            toggleId.value = id;
            if (status === 'Active') {
                toggleText.textContent = 'Pause';
                toggleIcon.className = 'bi bi-pause-circle me-1';
                toggleBtn.className = 'btn btn-sm btn-outline';
            } else {
                toggleText.textContent = 'Activate';
                toggleIcon.className = 'bi bi-play-circle me-1';
                toggleBtn.className = 'btn btn-sm btn-success';
            }

            deleteBtn.disabled = false;
            deleteId.value = id;
        }

        table.querySelectorAll('tbody tr.selectable-row').forEach(row => {
            row.addEventListener('click', function () {
                selectProduct(this);
            });
        });

        table.querySelectorAll('.agent-prod-radio').forEach(radio => {
            radio.addEventListener('change', function () {
                const row = this.closest('tr');
                if (row) selectProduct(row);
            });
        });
    });
</script>
}


@model IMS.ViewModels.SetNewPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Set New Password - InsureHub";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f3f5fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            color: #1e293b;
        }

        .ambient-glow-tr {
            position: fixed;
            top: -10%;
            right: -5%;
            width: 540px;
            height: 540px;
            background: radial-gradient(circle, rgba(196, 181, 253, 0.45) 0%, rgba(221, 214, 254, 0.12) 50%, transparent 70%);
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 1;
        }

        .ambient-glow-bl {
            position: fixed;
            bottom: -15%;
            left: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(191, 219, 254, 0.45) 0%, rgba(147, 197, 253, 0.12) 50%, transparent 70%);
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            z-index: 1;
        }

        .auth-card-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 980px;
            margin: 24px auto;
            padding: 0 16px;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 36px;
            box-shadow: 0 25px 70px -15px rgba(45, 55, 115, 0.1), 0 10px 25px -8px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.9);
            display: grid;
            grid-template-columns: 1fr;
            padding: 16px;
            gap: 16px;
            overflow: hidden;
        }

        @@media (min-width: 920px) {
            .auth-card {
                grid-template-columns: 46% 54%;
                gap: 0;
            }
        }

        .auth-hero-panel {
            background: linear-gradient(155deg, #4361ee 0%, #3f37c9 50%, #3a0ca3 100%);
            border-radius: 28px;
            padding: 42px 36px 32px;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            min-height: 480px;
        }

        .hero-title {
            font-size: 32px;
            font-weight: 800;
            line-height: 1.22;
            letter-spacing: -0.025em;
            color: #ffffff;
            margin-bottom: 14px;
        }

        .hero-subtitle {
            font-size: 13.5px;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.85);
            max-width: 340px;
            font-weight: 400;
        }

        .hero-illustration-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            margin-top: 36px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-illustration-wrapper svg {
            width: 100%;
            max-width: 300px;
            height: auto;
        }

        .auth-form-panel {
            padding: 38px 44px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @@media (max-width: 919px) {
            .auth-form-panel {
                padding: 24px 16px;
            }
        }

        .auth-brand-area {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
        }

        .brand-logo-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4361ee, #3a0ca3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 19px;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.35);
        }

        .brand-name {
            font-size: 21px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
        }

        .brand-name span {
            color: #4361ee;
        }

        .auth-heading {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.025em;
            margin-bottom: 6px;
        }

        .auth-subheading {
            font-size: 13.5px;
            color: #64748b;
            margin-bottom: 24px;
            font-weight: 400;
        }

        .auth-input-group {
            margin-bottom: 16px;
            position: relative;
        }

        .auth-label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .auth-input {
            width: 100%;
            height: 48px;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 13px;
            padding: 0 16px;
            font-size: 14px;
            color: #0f172a;
            font-family: inherit;
            outline: none;
            transition: all 0.2s ease;
        }

        .auth-input::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .auth-input:focus {
            background: #ffffff;
            border-color: #4361ee;
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.12);
        }

        .password-field-wrapper {
            position: relative;
        }

        .password-toggle-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 6px;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .password-toggle-btn:hover {
            color: #4361ee;
        }

        .field-validation-error {
            font-size: 11px;
            color: #ef4444;
            margin-top: 4px;
            display: block;
        }

        .auth-btn-primary {
            width: 100%;
            height: 50px;
            background: #4361ee;
            color: #ffffff;
            border: none;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 24px -4px rgba(67, 97, 238, 0.4);
            transition: all 0.2s ease;
            margin-top: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .auth-btn-primary:hover {
            background: #3651d4;
            transform: translateY(-1px);
            box-shadow: 0 12px 28px -4px rgba(67, 97, 238, 0.5);
        }

        .auth-btn-primary:active {
            transform: translateY(0);
        }

        .auth-bottom-text {
            text-align: center;
            font-size: 13px;
            color: #64748b;
            margin-top: 24px;
        }

        .auth-bottom-text a {
            color: #4361ee;
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
        }

        .auth-bottom-text a:hover {
            text-decoration: underline;
        }

        .alert-box {
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 13px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-box.success {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #047857;
        }

        .alert-box.danger {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #be123c;
        }

        .strength-track {
            height: 5px;
            width: 100%;
            background: #f1f5f9;
            border-radius: 99px;
            overflow: hidden;
            margin-top: 8px;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            transition: all 0.3s ease;
            border-radius: 99px;
        }
    </style>
</head>
<body>

    <!-- Ambient Background Glows -->
    <div class="ambient-glow-tr"></div>
    <div class="ambient-glow-bl"></div>

    <div class="auth-card-wrapper">
        <div class="auth-card">

            <!-- LEFT PANEL: SIMPLE, FIGMA-FRIENDLY INSURANCE HERO -->
            <div class="auth-hero-panel">
                <div class="hero-text-content">
                    <h1 class="hero-title">
                        Simplify<br />
                        protection with<br />
                        our insurance
                    </h1>
                    <p class="hero-subtitle">
                        Manage your policies, track incident claims, and get instant quote approvals with our user friendly insurance platform.
                    </p>
                </div>

                <div class="hero-illustration-wrapper">
                    <svg viewBox="0 0 280 230" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="140" cy="115" r="85" fill="#ffffff" fill-opacity="0.1" />
                        <path d="M140 28C178 28 208 40 212 80C212 132 172 170 140 192C108 170 68 132 68 80C72 40 102 28 140 28Z"
                              fill="url(#shieldGradSimple)"
                              stroke="#ffffff"
                              stroke-width="2.5"
                              stroke-opacity="0.35" />
                        <path d="M140 68C122 68 107 82 107 98H173C173 82 158 68 140 68Z" fill="#ffffff" />
                        <path d="M140 62V68" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
                        <path d="M140 98V122C140 126 136 129 133 129C130 129 127 126 127 123" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />

                        <g transform="translate(156, 42)">
                            <rect width="108" height="32" rx="16" fill="#ffffff" fill-opacity="0.2" stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.2" />
                            <circle cx="16" cy="16" r="8" fill="#10b981" />
                            <path d="M13 16L15 18L19 14" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <text x="30" y="20" fill="#ffffff" font-size="10.5" font-weight="700" font-family="'Plus Jakarta Sans', sans-serif">100% Safe</text>
                        </g>

                        <g transform="translate(16, 148)">
                            <rect width="114" height="32" rx="16" fill="#ffffff" fill-opacity="0.2" stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.2" />
                            <circle cx="16" cy="16" r="8" fill="#fbbf24" />
                            <path d="M16 11L14 16H18L16 21L20 15H16L18 11Z" fill="#ffffff" />
                            <text x="30" y="20" fill="#ffffff" font-size="10.5" font-weight="700" font-family="'Plus Jakarta Sans', sans-serif">Fast Claims</text>
                        </g>

                        <defs>
                            <linearGradient id="shieldGradSimple" x1="68" y1="28" x2="212" y2="192" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#60a5fa" />
                                <stop offset="1" stop-color="#2563eb" />
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>

            <!-- RIGHT PANEL: SET NEW PASSWORD FORM -->
            <div class="auth-form-panel">
                <div class="auth-brand-area">
                    <div class="brand-logo-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="brand-name">
                        Insure<span>Hub</span>
                    </div>
                </div>

                <h2 class="auth-heading">Set New Password</h2>
                <p class="auth-subheading">Choose a strong, unique password with at least 6 characters.</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-box success">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert-box danger">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert-box danger" role="alert"></div>

                <form asp-action="SetNewPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <!-- New Password -->
                    <div class="auth-input-group">
                        <label asp-for="NewPassword" class="auth-label">New Password</label>
                        <div class="password-field-wrapper">
                            <input asp-for="NewPassword" type="password" id="inputNewPass" oninput="checkStrength(this.value)" class="auth-input" placeholder="Minimum 6 characters" required minlength="6" autofocus />
                            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('inputNewPass', this)" title="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>

                        <div class="strength-track">
                            <div id="strengthBar" class="strength-fill"></div>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-top: 4px;">
                            <span>Strength</span>
                            <span id="strengthText" style="font-weight: 700;">None</span>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="auth-input-group">
                        <label asp-for="ConfirmPassword" class="auth-label">Confirm New Password</label>
                        <div class="password-field-wrapper">
                            <input asp-for="ConfirmPassword" type="password" id="inputConfirmPass" class="auth-input" placeholder="Repeat new password" required minlength="6" />
                            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('inputConfirmPass', this)" title="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="auth-btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        <span>Update Password & Sign In</span>
                    </button>

                    <div class="auth-bottom-text">
                        <a asp-action="Login">Cancel & Return to Sign In</a>
                    </div>
                </form>
            </div>

        </div>
    </div>

    <script>
        function togglePasswordVisibility(inputId, btn) {
            const el = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (el.type === 'password') {
                el.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                el.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function checkStrength(val) {
            const bar = document.getElementById('strengthBar');
            const txt = document.getElementById('strengthText');
            if (!val || val.length === 0) {
                bar.style.width = '0%';
                txt.innerText = 'None';
                txt.style.color = '#94a3b8';
                return;
            }

            let score = 0;
            if (val.length >= 6) score += 25;
            if (val.length >= 10) score += 25;
            if (/[0-9]/.test(val)) score += 25;
            if (/[^A-Za-z0-9]/.test(val)) score += 25;

            bar.style.width = score + '%';

            if (score <= 25) {
                bar.style.backgroundColor = '#ef4444';
                txt.innerText = 'Weak';
                txt.style.color = '#ef4444';
            } else if (score <= 50) {
                bar.style.backgroundColor = '#f59e0b';
                txt.innerText = 'Fair';
                txt.style.color = '#f59e0b';
            } else if (score <= 75) {
                bar.style.backgroundColor = '#3b82f6';
                txt.innerText = 'Good';
                txt.style.color = '#3b82f6';
            } else {
                bar.style.backgroundColor = '#10b981';
                txt.innerText = 'Strong';
                txt.style.color = '#10b981';
            }
        }
    </script>

</body>
</html>


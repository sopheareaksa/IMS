@model IMS.ViewModels.VerifyOtpViewModel
@{
    Layout = null;
    ViewData["Title"] = "Verify Code - InsureHub";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f3f5fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            color: #1e293b;
        }

        .ambient-glow-tr {
            position: fixed;
            top: -10%;
            right: -5%;
            width: 540px;
            height: 540px;
            background: radial-gradient(circle, rgba(196, 181, 253, 0.45) 0%, rgba(221, 214, 254, 0.12) 50%, transparent 70%);
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 1;
        }

        .ambient-glow-bl {
            position: fixed;
            bottom: -15%;
            left: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(191, 219, 254, 0.45) 0%, rgba(147, 197, 253, 0.12) 50%, transparent 70%);
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            z-index: 1;
        }

        .auth-card-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 980px;
            margin: 24px auto;
            padding: 0 16px;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 36px;
            box-shadow: 0 25px 70px -15px rgba(45, 55, 115, 0.1), 0 10px 25px -8px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.9);
            display: grid;
            grid-template-columns: 1fr;
            padding: 16px;
            gap: 16px;
            overflow: hidden;
        }

        @@media (min-width: 920px) {
            .auth-card {
                grid-template-columns: 46% 54%;
                gap: 0;
            }
        }

        .auth-hero-panel {
            background: linear-gradient(155deg, #4361ee 0%, #3f37c9 50%, #3a0ca3 100%);
            border-radius: 28px;
            padding: 42px 36px 32px;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            min-height: 480px;
        }

        .hero-title {
            font-size: 32px;
            font-weight: 800;
            line-height: 1.22;
            letter-spacing: -0.025em;
            color: #ffffff;
            margin-bottom: 14px;
        }

        .hero-subtitle {
            font-size: 13.5px;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.85);
            max-width: 340px;
            font-weight: 400;
        }

        .hero-illustration-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            margin-top: 36px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-illustration-wrapper svg {
            width: 100%;
            max-width: 300px;
            height: auto;
        }

        .auth-form-panel {
            padding: 38px 44px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @@media (max-width: 919px) {
            .auth-form-panel {
                padding: 24px 16px;
            }
        }

        .auth-brand-area {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
        }

        .brand-logo-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4361ee, #3a0ca3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 19px;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.35);
        }

        .brand-name {
            font-size: 21px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
        }

        .brand-name span {
            color: #4361ee;
        }

        .auth-heading {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.025em;
            margin-bottom: 6px;
        }

        .auth-subheading {
            font-size: 13.5px;
            color: #64748b;
            margin-bottom: 24px;
            font-weight: 400;
            line-height: 1.5;
        }

        .otp-input-field {
            width: 100%;
            height: 56px;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 16px;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 0.35em;
            text-align: center;
            font-family: 'JetBrains Mono', monospace;
            color: #0f172a;
            outline: none;
            transition: all 0.2s ease;
        }

        .otp-input-field:focus {
            background: #ffffff;
            border-color: #4361ee;
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.12);
        }

        .auth-btn-primary {
            width: 100%;
            height: 50px;
            background: #4361ee;
            color: #ffffff;
            border: none;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 24px -4px rgba(67, 97, 238, 0.4);
            transition: all 0.2s ease;
            margin-top: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .auth-btn-primary:hover {
            background: #3651d4;
            transform: translateY(-1px);
            box-shadow: 0 12px 28px -4px rgba(67, 97, 238, 0.5);
        }

        .auth-btn-primary:active {
            transform: translateY(0);
        }

        .auth-bottom-text {
            text-align: center;
            font-size: 13px;
            color: #64748b;
            margin-top: 24px;
        }

        .auth-bottom-text a {
            color: #4361ee;
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
        }

        .auth-bottom-text a:hover {
            text-decoration: underline;
        }

        .alert-box {
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 13px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-box.success {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #047857;
        }

        .alert-box.danger {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #be123c;
        }

        .email-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 12.5px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 99px;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>

    <!-- Ambient Background Glows -->
    <div class="ambient-glow-tr"></div>
    <div class="ambient-glow-bl"></div>

    <div class="auth-card-wrapper">
        <div class="auth-card">

            <!-- LEFT PANEL: SIMPLE, FIGMA-FRIENDLY INSURANCE HERO -->
            <div class="auth-hero-panel">
                <div class="hero-text-content">
                    <h1 class="hero-title">
                        Simplify<br />
                        protection with<br />
                        our insurance
                    </h1>
                    <p class="hero-subtitle">
                        Manage your policies, track incident claims, and get instant quote approvals with our user friendly insurance platform.
                    </p>
                </div>

                <div class="hero-illustration-wrapper">
                    <svg viewBox="0 0 280 230" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="140" cy="115" r="85" fill="#ffffff" fill-opacity="0.1" />
                        <path d="M140 28C178 28 208 40 212 80C212 132 172 170 140 192C108 170 68 132 68 80C72 40 102 28 140 28Z"
                              fill="url(#shieldGradSimple)"
                              stroke="#ffffff"
                              stroke-width="2.5"
                              stroke-opacity="0.35" />
                        <path d="M140 68C122 68 107 82 107 98H173C173 82 158 68 140 68Z" fill="#ffffff" />
                        <path d="M140 62V68" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
                        <path d="M140 98V122C140 126 136 129 133 129C130 129 127 126 127 123" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />

                        <g transform="translate(156, 42)">
                            <rect width="108" height="32" rx="16" fill="#ffffff" fill-opacity="0.2" stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.2" />
                            <circle cx="16" cy="16" r="8" fill="#10b981" />
                            <path d="M13 16L15 18L19 14" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <text x="30" y="20" fill="#ffffff" font-size="10.5" font-weight="700" font-family="'Plus Jakarta Sans', sans-serif">100% Safe</text>
                        </g>

                        <g transform="translate(16, 148)">
                            <rect width="114" height="32" rx="16" fill="#ffffff" fill-opacity="0.2" stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.2" />
                            <circle cx="16" cy="16" r="8" fill="#fbbf24" />
                            <path d="M16 11L14 16H18L16 21L20 15H16L18 11Z" fill="#ffffff" />
                            <text x="30" y="20" fill="#ffffff" font-size="10.5" font-weight="700" font-family="'Plus Jakarta Sans', sans-serif">Fast Claims</text>
                        </g>

                        <defs>
                            <linearGradient id="shieldGradSimple" x1="68" y1="28" x2="212" y2="192" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#60a5fa" />
                                <stop offset="1" stop-color="#2563eb" />
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>

            <!-- RIGHT PANEL: VERIFY OTP FORM -->
            <div class="auth-form-panel">
                <div class="auth-brand-area">
                    <div class="brand-logo-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="brand-name">
                        Insure<span>Hub</span>
                    </div>
                </div>

                <h2 class="auth-heading">Verify Code</h2>
                <p class="auth-subheading">Enter the 6-digit security code sent to your email to verify your identity.</p>

                <div class="email-pill">
                    <i class="bi bi-envelope-check"></i>
                    <span>@Model.Email</span>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-box success">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert-box danger" role="alert"></div>

                <form asp-action="VerifyOTP" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <div style="margin-bottom: 8px;">
                        <input asp-for="Otp" type="text" maxlength="6" class="otp-input-field" placeholder="••••••" required autofocus autocomplete="one-time-code" />
                        <span asp-validation-for="Otp" class="field-validation-error" style="color: #ef4444; font-size: 11.5px; margin-top: 6px; display: block; text-align: center;"></span>
                    </div>

                    <div style="text-align: center; font-size: 12px; color: #94a3b8; margin-top: 10px; margin-bottom: 6px;">
                        <i class="bi bi-clock-history"></i>
                        <span>Code expires in 5 minutes</span>
                    </div>

                    <button type="submit" class="auth-btn-primary">
                        <span>Verify Code & Continue</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                    <div class="auth-bottom-text">
                        <a asp-action="ForgotPassword" style="margin-right: 12px;"><i class="bi bi-arrow-clockwise"></i> Resend Code</a>
                        <a asp-action="Login" style="color: #64748b; font-weight: 500;">Cancel</a>
                    </div>
                </form>
            </div>

        </div>
    </div>

</body>
</html>


@model IMS.ViewModels.PaymentResultViewModel
@{
    ViewData["Title"] = "Payment Successful - Policy Activated";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Success Animation / Header Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-center mb-4">
                <div class="card-body p-4 p-md-5">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3 shadow-sm" style="width: 76px; height: 76px;">
                        <i class="bi bi-check-lg fs-1"></i>
                    </div>
                    <h2 class="fw-extrabold text-success mb-2">Payment Completed Successfully!</h2>
                    <p class="text-muted mb-0">
                        Your transaction has been verified with NBC Bakong. Insurance Policy <strong>#@Model.PolicyNumber</strong> is officially issued and currently <strong>ACTIVE</strong>.
                    </p>
                </div>
            </div>

            <!-- Official Policy Receipt Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-fill-check text-success fs-5"></i>
                        <h6 class="mb-0 fw-bold">Official Policy Receipt & Underwriting Certificate</h6>
                    </div>
                    <span class="badge bg-success text-uppercase px-2.5 py-1">Active</span>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="row g-4 mb-4 pb-4 border-bottom">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Policyholder</span>
                            <h5 class="fw-bold text-dark mb-0">@Model.CustomerName</h5>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <span class="text-muted small d-block">Official Policy Number</span>
                            <h5 class="fw-bold text-primary font-monospace mb-0">@Model.PolicyNumber</h5>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Insurance Plan</span>
                            <strong class="text-dark">@Model.ProductName</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Underwriting Carrier</span>
                            <strong class="text-dark">@Model.CompanyName</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Total Coverage Limit</span>
                            <strong class="text-success">$@Model.CoverageAmount.ToString("N2")</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Coverage Term</span>
                            <span class="text-dark fw-semibold">
                                @Model.StartDate.ToString("MMM dd, yyyy") &mdash; @Model.EndDate.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.BeneficiaryName))
                        {
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Designated Beneficiary</span>
                                <span class="text-dark">@Model.BeneficiaryName (@(string.IsNullOrEmpty(Model.BeneficiaryRelation) ? "Primary" : Model.BeneficiaryRelation))</span>
                            </div>
                        }
                    </div>

                    <!-- Payment Transaction Proof -->
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold small text-dark">
                                @if (Model.PaymentMethod.Contains("KHQR") || Model.PaymentMethod.Contains("Bakong"))
                                {
                                    <i class="bi bi-qr-code text-danger me-1"></i><span>Bakong KHQR Payment</span>
                                }
                                else if (Model.PaymentMethod.Contains("Card"))
                                {
                                    <i class="bi bi-credit-card-2-front text-primary me-1"></i><span>Credit / Debit Card Payment</span>
                                }
                                else
                                {
                                    <i class="bi bi-bank text-success me-1"></i><span>Bank Transfer Payment</span>
                                }
                            </span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Payment Verified</span>
                        </div>
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Amount Paid:</span>
                                <strong class="text-success fs-6">$@Model.PremiumAmount.ToString("N2") @Model.Currency</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Payment Method:</span>
                                <span class="fw-bold text-dark">@Model.PaymentMethod</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Payment Date:</span>
                                <span>@Model.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.MaskedAccountOrCard))
                            {
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">Account / Identifier:</span>
                                    <code class="text-dark">@Model.MaskedAccountOrCard</code>
                                </div>
                            }
                            <div class="col-12">
                                <span class="text-muted d-block">Transaction Reference / Hash:</span>
                                <code class="text-break font-monospace">@Model.TransactionRef</code>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-controller="Customer" asp-action="MyPolicies" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="bi bi-file-earmark-check me-1"></i> View in My Policies
                        </a>
                        <div class="d-flex gap-2">
                            <button onclick="window.print()" class="btn btn-outline-secondary">
                                <i class="bi bi-printer me-1"></i> Print Receipt
                            </button>
                            <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-outline-dark">
                                <i class="bi bi-house me-1"></i> Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@model IEnumerable<IMS.Models.InsurancePolicy>
@{
    ViewData["Title"] = "My Insurance Policies";
    int activeCount = Model.Count(p => p.status == "Active");
}

<div class="page-header">
    <div>
        <div class="page-header-title">My Insurance Policies & Certificates</div>
        <div class="page-header-sub">Active binding legal coverages, certificate terms, and incident claims history.</div>
    </div>
    <div class="page-header-actions">
        @if (activeCount > 0)
        {
            <a asp-action="SubmitClaim" class="btn btn-danger btn-md">
                <i class="bi bi-exclamation-octagon-fill"></i> Report Loss / File Claim
            </a>
        }
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var pol in Model)
        {
            <div class="col-12 col-lg-6">
                <div class="card h-100 border-0 shadow-sm" style="border: 1px solid #e5e7eb !important; border-radius: 16px; overflow: hidden;">
                    <!-- Banner -->
                    <div style="background: linear-gradient(135deg, #1e293b, #0f172a); padding: 22px 24px; color: #fff;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge badge-primary mb-2">@(pol.Quotation?.InsuranceProduct?.InsuranceType?.name ?? "Insurance Policy")</span>
                                <h5 class="fw-bold text-white mb-1" style="font-size: 17px;">@pol.Quotation?.InsuranceProduct?.name</h5>
                                <div class="small text-white-50"><i class="bi bi-buildings me-1"></i>Carrier: @pol.Quotation?.InsuranceProduct?.Company?.name</div>
                                @if (pol.Agent != null)
                                {
                                    <div class="small text-info mt-1"><i class="bi bi-person-badge me-1"></i>Underwriter: @pol.Agent.fullName</div>
                                }
                            </div>
                            <span class="badge @(pol.status == "Active" ? "badge-success" : "badge-gray") px-2.5 py-1">
                                @pol.status
                            </span>
                        </div>
                    </div>

                    <!-- Metrics Grid -->
                    <div class="p-4 flex-grow-1">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; font-weight: 700;">Policy Number</span>
                                    <code class="fw-bold text-dark" style="font-size: 13px;">@pol.policyNumber</code>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; font-weight: 700;">Coverage Limit</span>
                                    <span class="fw-bold text-primary" style="font-size: 14px;">$@pol.coverageAmount.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; font-weight: 700;">Annual Premium</span>
                                    <span class="fw-bold text-success" style="font-size: 14px;">$@pol.premiumAmount.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; font-weight: 700;">Valid Term</span>
                                    <span class="text-dark small fw-semibold">@pol.startDate.ToString("MMM dd, yyyy") &ndash; @pol.endDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Beneficiaries -->
                        @if (pol.Beneficiaries.Any())
                        {
                            <div class="p-3 bg-light rounded-3 border mb-3 small">
                                <div class="fw-bold text-dark mb-1.5"><i class="bi bi-people me-1 text-primary"></i>Designated Beneficiaries:</div>
                                @foreach (var b in pol.Beneficiaries)
                                {
                                    <div class="d-flex justify-content-between text-secondary py-0.5">
                                        <span>@b.name (@b.relation)</span>
                                        <span class="fw-bold text-dark">@b.sharePercentage%</span>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Claims -->
                        @if (pol.Claims.Any())
                        {
                            <div class="p-3 rounded-3 border mb-3 small" style="background: #fff1f2; border-color: #fecdd3 !important;">
                                <div class="fw-bold text-danger mb-1.5"><i class="bi bi-exclamation-octagon me-1"></i>Incident Claims Filed:</div>
                                @foreach (var cl in pol.Claims)
                                {
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-danger-subtle">
                                        <span>#@cl.claimId &bull; @cl.incidentType ($@cl.claimAmount.ToString("N2"))</span>
                                        <span class="badge @(cl.status == "Approved" || cl.status == "Paid" ? "badge-success" : "badge-warning")">@cl.status</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Footer Action -->
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 px-4">
                        <span class="small text-muted">Desk: @(pol.Agent?.fullName ?? "Platform Underwriter")</span>
                        <a asp-action="SubmitClaim" asp-route-inPoId="@pol.inPoId" class="btn btn-sm btn-outline text-danger">
                            <i class="bi bi-shield-exclamation me-1"></i> Report Incident
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card p-5 text-center">
        <div class="empty-state">
            <div class="empty-state-icon"><i class="bi bi-shield-x"></i></div>
            <div class="empty-state-title">No active insurance policies</div>
            <div class="empty-state-desc">You do not currently have any active insurance policies. Explore plans to get protected today.</div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-md">
                <i class="bi bi-grid me-1"></i> Browse Insurance Catalog
            </a>
        </div>
    </div>
}
